# Copy to .env to override defaults. Nothing here is secret: the practice site is public.
BASE_URL=https://testautomationpractice.blogspot.com
BROWSER=chrome            # chrome | firefox | edge
HEADLESS=true             # true | false
EXPLICIT_TIMEOUT=15       # seconds for explicit waits
PAGE_LOAD_TIMEOUT=60      # seconds
WINDOW_SIZE=1920,1080
# SELENIUM_REMOTE_URL=http://localhost:4444/wd/hub   # run on Selenium Grid / Docker
